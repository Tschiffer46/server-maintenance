# Central konfiguration för energi-migrationen.
# ÄNDRA HÄR om server, domän eller subnät skiljer sig — alla script läser denna fil.

# Hetzner-VPS:en (den som kör Docker + Nginx Proxy Manager)
HETZNER_IP="89.167.90.112"
HETZNER_SSH="deploy@89.167.90.112"

# Publik domän för dashboarden (DNS-post måste peka på HETZNER_IP)
ENERGI_DOMAIN="energi.agiletransition.se"

# WireGuard-tunneln (isolerat interface, påverkar inget annat på servern)
WG_IF="wg-hem"
WG_PORT="51820"                # UDP — måste öppnas i UFW + ev. Hetzner Cloud Firewall
WG_NET="10.8.20.0/24"          # Tunnelnät — får inte krocka med hemmanät/dockernät
WG_HETZNER_IP="10.8.20.1"      # Serverns tunnel-IP
WG_ROUTER_IP="10.8.20.2"       # Routerns tunnel-IP

# Mätarna på hemmanätet (ENDAST dessa två ska vara nåbara genom tunneln)
SUNGROW_IP="192.168.1.202"     # Sungrow-växelriktare via WiNet-S2, Modbus TCP
SUNGROW_PORT="502"
SHELLY_IP="192.168.1.96"       # Shelly Pro 3EM, HTTP
SHELLY_PORT="80"

# Hemmaroutern (OpenWrt)
ROUTER_SSH="root@192.168.1.1"

# Var appen bor på Hetzner-servern
DEPLOY_DIR="/home/deploy/hosting/energi"

# Var appen bor på Macen (källan för migrationen)
MAC_APP_DIR="$HOME/energi"
